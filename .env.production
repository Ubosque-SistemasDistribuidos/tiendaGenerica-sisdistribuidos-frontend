# Modo Mock desactivado en producción (true = usa API Real en tu código)
VITE_USE_MOCK_BACKEND=true

# URLs de los Microservicios proxied a través de vercel.json
VITE_BACKEND_URL=/api/backend/
VITE_CLIENTE_URL=/api/cliente/
VITE_USUARIO_URL=/api/usuario/
VITE_PROVEEDOR_URL=/api/proveedor/
VITE_PRODUCTO_URL=/api/producto/
VITE_VENTA_URL=/api/venta/
VITE_DETALLE_VENTA_URL=/api/detalleVenta/
