# TiendaGenerica Frontend - Variables de Entorno
# Copia este archivo a .env y ajusta los valores según tu entorno

# Usar Mock Backend - true para datos simulados, false para APIs reales
VITE_USE_MOCK_BACKEND=false

# URL del API Principal (Microservicio de Ventas)
VITE_API_URL=http://localhost:8088

# URL del API de Proveedores (Microservicio de Proveedores)
VITE_PROVIDERS_API_URL=http://localhost:8091
